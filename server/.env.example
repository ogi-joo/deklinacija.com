# Copy to .env and adjust as needed. All variables are optional.

# Port the HTTP server listens on (default: 3009)
PORT=3009

# Path to the names dataset (default: ../vocative.json, i.e. the repo root)
NAMES_PATH=../vocative.json

# Path to the on-disk BoltDB cache, rebuilt from NAMES_PATH on startup (default: names.db)
DB_PATH=names.db

# Analytics are OFF by default. Set a PostHog project key to enable the
# tracking snippet on the landing page. Leave empty to keep it disabled.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
